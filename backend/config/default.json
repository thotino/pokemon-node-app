{
    "service": {
        "name": "pokemon-node-api",
        "version": "1.0.0"
    },
    "webserver": {
        "port": "3001"
    },
    "connectors": {
        "pokeStore": {
            "url": "http://localhost:9200"
        },
        "chatbot": {
            "url": "https://chatbot-api.getvirtualbrain.com",
            "apiKey": "",
            "chatbotId": ""
        }
    },
    "settings": {
        "workingDir": "/tmp",
        "chatbotRetry": {
            "limit": 3,
            "maxRetryAfterMs": 10000,
            "backoffLimitMs": 5000
        }
    }
}